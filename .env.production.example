# ===================================================
# THE ROAD SO FAR — BACKEND ENV PRODUÇÃO (Hostinger)
# No servidor: copie para .env e preencha os valores reais
# NUNCA commite o .env com valores reais
# ===================================================

# App
NODE_ENV=production
PORT=3001
API_URL=https://api.theroadsofar.com.br

# JWT — gere NOVOS valores para produção:  openssl rand -hex 32
JWT_SECRET=TROQUE_POR_STRING_ALEATORIA_DE_64_CARACTERES_NO_MINIMO
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=TROQUE_POR_OUTRA_STRING_ALEATORIA_DE_64_CARACTERES
JWT_REFRESH_EXPIRES_IN=7d

# Database — MySQL da Hostinger
# A porta da Hostinger é SEMPRE 3306 (a 3302 é só do seu Docker local).
# Nome do banco e usuário levam o prefixo da sua conta (ex.: u123456789_theroadsofar).
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=u123456789_trsf
DB_PASSWORD=SENHA_FORTE_AQUI
DB_NAME=u123456789_theroadsofar
DB_SSL=false

# Upload
UPLOAD_DIR=/home/SEU_USUARIO/uploads
UPLOAD_MAX_SIZE_MB=10
UPLOAD_MAX_VIDEO_MB=100
UPLOAD_MAX_AUDIO_MB=30
UPLOAD_MAX_DOC_MB=20
# A própria API serve os arquivos em /uploads
PUBLIC_UPLOAD_URL=https://api.theroadsofar.com.br/uploads

# Email (SMTP)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=noreply@theroadsofar.com.br
MAIL_PASS=SENHA_EMAIL_AQUI
MAIL_FROM="The Road So Far <noreply@theroadsofar.com.br>"

# CORS — o site público + o painel admin que roda no SEU PC (localhost:3002).
# Sem o localhost:3002 aqui, o navegador bloqueia o admin de publicar na API.
# (Isso não abre brecha: toda rota admin continua exigindo JWT com role ADMIN.)
CORS_ORIGINS=https://theroadsofar.com.br,https://www.theroadsofar.com.br,http://localhost:3002

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
