# ===================================================
# THE ROAD SO FAR — BACKEND ENV LOCAL (desenvolvimento)
# Para produção na Hostinger use .env.production.example como base
# NUNCA commite este arquivo
# ===================================================

# App
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# JWT (em produção use valores DIFERENTES destes)
JWT_SECRET=TROQUE_POR_STRING_ALEATORIA_DE_64_CARACTERES_NO_MINIMO
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=TROQUE_POR_OUTRA_STRING_ALEATORIA_DE_64_CARACTERES
JWT_REFRESH_EXPIRES_IN=7d

# Database (MySQL 8 no Docker — porta 3302 no seu PC)
# Use 127.0.0.1 em vez de "localhost" (no Windows "localhost" pode ir para IPv6 ::1)
DB_HOST=127.0.0.1
DB_PORT=3302
DB_USERNAME=trsf_user
DB_PASSWORD=trsf9180
DB_NAME=theroadsofar
DB_SSL=false

# Upload (pasta local)
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=10
UPLOAD_MAX_VIDEO_MB=100
UPLOAD_MAX_AUDIO_MB=30
UPLOAD_MAX_DOC_MB=20
PUBLIC_UPLOAD_URL=http://localhost:3001/uploads

# Email (SMTP)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=noreply@theroadsofar.com.br
MAIL_PASS=SENHA_EMAIL_AQUI
MAIL_FROM="The Road So Far <noreply@theroadsofar.com.br>"

# CORS — site (3000) e painel admin (3002) locais
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
